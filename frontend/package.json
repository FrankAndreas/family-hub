{
  "name": "hub-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "npm run theme:copy",
    "dev": "vite",
    "prebuild": "npm run theme:copy",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && npm run check-texts && npm run check-colors",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "check-colors": "node scripts/check-colors.mjs --self-test && node scripts/check-colors.mjs",
    "check-texts": "node scripts/check-texts.mjs",
    "test": "vitest run --passWithNoTests",
    "prepare": "git config core.hooksPath .githooks || true",
    "theme:copy": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/family-hub-theme/theme-init.js','public/theme-init.js')\""
  },
  "dependencies": {
    "axios": "^1.21.1",
    "family-hub-theme": "file:../theme",
    "i18next": "26.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-i18next": "17.1.13",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
