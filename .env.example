# Copy to .env next to compose.yaml (chmod 600). Empty values use the defaults in docker-compose.yml.

# The DSM user the backend runs as (see README_DOCKER.md); default 999:999
PUID=999
PGID=999
# Port on the NAS
PORT=8086
# First parent's PIN on an empty database (4 digits); empty = random, printed once in the backend log
INITIAL_ADMIN_PIN=
# de or en: language of people who haven't picked one
DEFAULT_LANGUAGE=de
TZ=Europe/Zurich

# The login cookie's domain, e.g. local.<domain> (README_DOCKER.md, "At home")
COOKIE_DOMAIN=
# Forgot PIN by e-mail (README_DOCKER.md, "Forgot PIN"): a Resend API key, the sender, the hub's address at home;
# all three or the reset by mail is off
RESEND_API_KEY=
MAIL_FROM=
HUB_PUBLIC_URL=
# Cloudflare Access (README_DOCKER.md, "From outside"): e.g. <team>.cloudflareaccess.com and the application's AUD
CF_TEAM_DOMAIN=
CF_AUDIENCE=
